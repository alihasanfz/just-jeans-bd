# =========================================================
# JEANS BD - ENVIRONMENT CONFIGURATION
# =========================================================

# NEXT.JS APP
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SUPABASE (Optional for local testing / Connected for cloud)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# BKASH PAYMENT GATEWAY (SANDBOX / PRODUCTION)
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

# NAGAD PAYMENT GATEWAY (SANDBOX / PRODUCTION)
NAGAD_MERCHANT_ID=your_nagad_merchant_id
NAGAD_MERCHANT_PRIVATE_KEY=your_nagad_private_key
NAGAD_BASE_URL=https://sandbox.mynagad.com:10080/remote-payment-gateway-1.0/api/dfs

# =========================================================
# AI VIRTUAL TRY-ON (REAL CLOTHING REPLACEMENT DIFFUSION)
# =========================================================
# Active Provider: fashn | replicate | fal | gemini | auto
VIRTUAL_TRYON_PROVIDER=replicate

# Dedicated Provider Credentials (Keep server-side only in .env.local):
# 1. Fashn.ai (Dedicated Fashion Virtual Try-On API)
FASHN_API_KEY=fa_your_fashn_api_key_here

# 2. Replicate IDM-VTON Diffusion (starts with r8_...)
REPLICATE_API_TOKEN=r8_your_replicate_token_here

# 3. Fal.ai Fast Serverless IDM-VTON
FAL_KEY=fal_your_fal_key_here

# 4. Google Multimodal Vision API
GEMINI_API_KEY=your_google_ai_key_here

# Generic / Fallback key (accepts Replicate r8_... or Fashn fa_...)
VIRTUAL_TRYON_API_KEY=r8_your_key_here

# Privacy & Retention Configuration (in hours, default: 24)
TRYON_RETENTION_HOURS=24

